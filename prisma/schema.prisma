generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  phone       String?
  password    String?
  role        String   @default("OWNER")
  businessId  String?
  createdAt   DateTime @default(now())

  isPaying      Boolean   @default(false)
  totalPaid     Int       @default(0)
  nextBillingAt DateTime?
  
  // Subscription fields
  subscriptionStatus        String    @default("trial") // trial, active, cancelled, expired
  subscriptionType           String?                  // monthly, yearly
  trialEndsAt               DateTime?
  subscriptionEndsAt        DateTime?
  cloudPaymentsSubscriptionId String?
  cloudPaymentsCardToken     String?
  nextPaymentDate           DateTime?
  
  // Payment tracking fields
  lastPaymentStatus         String?   // success, failed, pending
  lastPaymentAmount         Int?      // amount in kopecks
  lastPaymentDate           DateTime?
  lastPaymentTransactionId  String?

  business Business? @relation("BusinessUsers", fields: [businessId], references: [id])
  ownedBusiness Business? @relation("BusinessOwner")

  staffProfile Staff?
  loginTokens  LoginToken[]
  salesStaffAssignments SalesStaffAssignment[]
  pushSubscriptions PushSubscription[]
  crmRecords CrmRecord[]
  userPermissions UserPermission[]
  adminAuditLogs  AdminAuditLog[]
}

model Business {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerId     String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("BusinessOwner", fields: [ownerId], references: [id])
  users User[] @relation("BusinessUsers")

  staff        Staff[]
  staffInvites StaffInvite[]
  services     Service[]
  categories   Category[]
  masters      Master[]
  workPhotos   WorkPhoto[]
  schedules    Schedule[]
  branches     Branch[]
  appointments Appointment[]
  pushSubscriptions PushSubscription[]
  subscription Subscription?
}

model Subscription {
  id                        String   @id @default(uuid())
  businessId                String   @unique
  plan                      String   // SOLO, STUDIO, PRO
  maxUsers                  Int      // 1, 5, 15
  isActive                  Boolean  @default(true)
  subscriptionStatus         String   @default("TRIAL") // TRIAL, ACTIVE, CANCELLED, EXPIRED
  trialEndsAt               DateTime?
  subscriptionEndsAt        DateTime?
  cloudpaymentsSubscriptionId String? @unique
  nextPaymentDate           DateTime?
  billingPeriod             String?  // MONTHLY, YEARLY
  lastPaymentAt             DateTime?
  cardAttachedAt            DateTime?
  autoRenewal               Boolean  @default(false) // Enable/disable automatic renewal
  trialToPaidConversionDate DateTime? // Date when trial converted to paid
  usersLimit                Int      @default(1) // Same as maxUsers for compatibility
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model Staff {
  id         String   @id @default(uuid())
  name       String
  userId     String   @unique
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model StaffInvite {
  id         String   @id @default(uuid())
  email      String
  businessId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model LoginToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id])
}

model Service {
  id         Int      @id @default(autoincrement())
  name       String
  duration   Int
  price      Int
  priceRange String?
  businessId String
  categoryId Int?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  appointments Appointment[]
}

model Category {
  id         Int       @id @default(autoincrement())
  name       String
  businessId String
  createdAt  DateTime  @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]
}

model Master {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?  @unique
  active     Boolean  @default(true)
  businessId String
  specializations String?
  avatarUrl  String?
  branchId   Int?
  schedule   Json?
  categoryIds Int[]
  serviceIds  Int[]
  createdAt  DateTime @default(now())

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?     @relation(fields: [branchId], references: [id])
  schedules Schedule[]
  appointments Appointment[]
}

model WorkPhoto {
  id         Int      @id @default(autoincrement())
  imageUrl   String
  caption    String?
  isLogo     Boolean  @default(false)
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Schedule {
  id         Int      @id @default(autoincrement())
  type       String
  email      String
  masterId   Int?
  businessId String
  days       Json
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  master  Master?  @relation(fields: [masterId], references: [id])
}

model Branch {
  id         Int      @id @default(autoincrement())
  name       String
  city       String?
  address    String?
  directions String?
  schedule   String?
  businessId String
  createdAt  DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  masters      Master[]
}

model Appointment {
  id                 Int      @id @default(autoincrement())
  customerName       String
  customerPhone      String?
  customerTelegram   String?
  telegramChatId     String?
  customerVkId       String?
  vkConnectedAt      DateTime?
  customerComment    String?
  startsAt           DateTime
  endsAt             DateTime
  startsAtLocal      String?  // Store original time with timezone offset for Telegram display
  endsAtLocal        String?  // Store original end time with timezone offset for Telegram display
  businessId         String
  serviceId          Int
  masterId           Int
  branchId           Int?
  status             String   @default("PENDING")
  bookingToken       String?  @unique
  reminderSent24h    Boolean  @default(false)
  reminderSent1h     Boolean  @default(false)
  vkReminderSent24h  Boolean  @default(false)
  vkReminderSent1h   Boolean  @default(false)
  createdAt          DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])
  master   Master   @relation(fields: [masterId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  vkLinkCodes VKLinkCode[]

  @@index([businessId, startsAt])
}

model VKLinkCode {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(10) // VK-XXXXXX
  businessId   String
  appointmentId Int
  customerName String
  customerPhone String
  vkUserId     BigInt?
  isUsed       Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  usedAt       DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([isUsed, expiresAt])
}

model SalesStaffAssignment {
  id         String   @id @default(uuid())
  salesStaffId String
  clientEmail  String
  assignedAt  DateTime @default(now())
  assignedBy  String

  salesStaff User @relation(fields: [salesStaffId], references: [id], onDelete: Cascade)

  @@unique([salesStaffId, clientEmail])
  @@index([clientEmail])
}

model PushSubscription {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String?
  businessId  String?
  userAgent   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lastActive  DateTime @default(now())

  user    User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@index([userId, isActive])
  @@index([token])
}

model CrmRecord {
  id          String   @id @default(uuid())
  staffId     String
  name        String
  phone       String?
  salon       String?
  tariff      String?
  date        DateTime?
  registered  Boolean  @default(false)
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
}

// ===== Partner / employee contractor program =====

model Employee {
    id                   String   @id @default(uuid())
    lastName             String
    firstName            String
    middleName           String?
    birthDate            DateTime
    phone                String
    email                String
    inn                  String
    isNpdPayer           Boolean
    region               String
    telegram             String?
    bankDetails          String
    ageCategory          String   @default("ADULT") // ADULT, MINOR

    // Minor / legal representative
    isFullLegalCapacity  Boolean  @default(false)
    emancipationDocumentType   String?
    emancipationDocumentNumber String?
    emancipationDocumentDate   DateTime?
    emancipationDocumentAuthority String?
    emancipationDocumentUrl    String?

    representativeLastName  String?
    representativeFirstName String?
    representativeMiddleName String?
    representativeBirthDate DateTime?
    representativePhone     String?
    representativeEmail     String?
    representativeAddress   String?
    representativeRelationship String? // MOTHER, FATHER, ADOPTIVE_PARENT, CURATOR, GUARDIAN
    representativeAuthorityDocumentUrl String?

    // Acceptance
    acceptedOffer        Boolean
    acceptedNpd          Boolean
    acceptedPrivacy      Boolean
    acceptedDataCorrect  Boolean

    // Separate timestamps for each legal consent
    offerAcceptedAt      DateTime?
    privacyAcceptedAt    DateTime?
    npdConfirmedAt       DateTime?
    dataCorrectConfirmedAt DateTime?

    // Legal versions accepted at the moment of application
    contractVersionId    String?
    privacyVersionId     String?

    // Idempotency key to prevent duplicate submissions
    idempotencyKey       String?  @unique

    // Audit / technical
    ipAddress            String
    userAgent            String
    status               String   @default("PENDING") // PENDING, GUARDIAN_CONSENT_CONFIRMED, PRIVACY_CONSENT_CONFIRMED, OFFER_ACCEPTED, CONFIRMED, REJECTED, ARCHIVED, ACCEPTED
    acceptedAt           DateTime?
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    contractVersion ContractVersion? @relation(fields: [contractVersionId], references: [id])
    privacyVersion  PolicyVersion?   @relation(fields: [privacyVersionId], references: [id])
    acceptance      EmployeeContractAcceptance?
    adminAuditLogs  AdminAuditLog[]
    documents       EmployeeDocument[]
    guardianConsent LegalRepresentativeConsent?
    minorPrivacyConsent MinorPersonalDataConsent?
    minorContractAcceptance MinorContractAcceptance?
    consentEvents   ConsentEvent[]

    @@index([email])
    @@index([inn])
    @@index([phone])
    @@index([createdAt])
    @@index([status])
    @@index([contractVersionId])
    @@index([ageCategory])
    @@index([representativeEmail])
}

model EmployeeContractAcceptance {
    id                String   @id @default(uuid())
    employeeId        String   @unique
    contractVersionId String
    privacyVersionId  String
    ipAddress         String
    userAgent         String
    acceptedAt        DateTime @default(now())

    employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
    contractVersion ContractVersion @relation(fields: [contractVersionId], references: [id])
    privacyVersion  PolicyVersion   @relation(fields: [privacyVersionId], references: [id])
}

model ContractVersion {
    id          String   @id @default(uuid())
    version     String   @unique // e.g. "1.0"
    hash        String   @unique
    title       String
    content     String   @db.Text
    activeFrom  DateTime @default(now())
    createdAt   DateTime @default(now())

    employees          Employee[]
    acceptances        EmployeeContractAcceptance[]
    legalRepresentativeConsents LegalRepresentativeConsent[]
    minorContractAcceptances MinorContractAcceptance[]
}

model PolicyVersion {
    id          String   @id @default(uuid())
    version     String   @unique // e.g. "1.0"
    hash        String   @unique
    title       String
    content     String   @db.Text
    activeFrom  DateTime @default(now())
    createdAt   DateTime @default(now())

    employees          Employee[]
    acceptances        EmployeeContractAcceptance[]
}

model Permission {
    id          String   @id @default(uuid())
    key         String   @unique // employees_data.view, employees_data.export, etc.
    description String?
    createdAt   DateTime @default(now())

    users UserPermission[]
}

model UserPermission {
    id           String   @id @default(uuid())
    userId       String
    permissionId String
    grantedAt    DateTime @default(now())

    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@unique([userId, permissionId])
}

model AdminAuditLog {
    id            String   @id @default(uuid())
    adminId       String
    action        String   // view, edit, export, delete
    entity        String   // employee, contract_version, etc.
    entityId      String?
    metadata      Json?
    createdAt     DateTime @default(now())

    admin    User    @relation(fields: [adminId], references: [id], onDelete: Cascade)
    employee Employee? @relation(fields: [entityId], references: [id])

    @@index([adminId])
    @@index([entity, entityId])
    @@index([createdAt])
}

model GuardianConsentVersion {
    id          String   @id @default(uuid())
    version     String   @unique
    hash        String   @unique
    title       String
    content     String   @db.Text
    activeFrom  DateTime @default(now())
    createdAt   DateTime @default(now())

    consents LegalRepresentativeConsent[]
}

model MinorPrivacyConsentVersion {
    id          String   @id @default(uuid())
    version     String   @unique
    hash        String   @unique
    title       String
    content     String   @db.Text
    activeFrom  DateTime @default(now())
    createdAt   DateTime @default(now())

    consents MinorPersonalDataConsent[]
}

model LegalRepresentativeConsent {
    id                       String   @id @default(uuid())
    employeeId               String   @unique
    token                    String   @unique
    status                   String   @default("PENDING") // PENDING, OTP_SENT, CONFIRMED, REJECTED, EXPIRED, LOCKED

    // Minor data snapshot
    minorLastName            String
    minorFirstName           String
    minorMiddleName          String?
    minorBirthDate           DateTime
    minorInn                 String

    // Representative data
    representativeLastName   String
    representativeFirstName  String
    representativeMiddleName String?
    representativeBirthDate  DateTime?
    representativeStatus     String   // MOTHER, FATHER, ADOPTIVE_PARENT, CURATOR, GUARDIAN
    representativeEmail      String
    representativePhone      String

    // Consent checkboxes
    confirmedRepresentative  Boolean  @default(false)
    representativeConsentAt  DateTime?
    confirmedConsent         Boolean  @default(false)
    consentGivenAt           DateTime?
    confirmedRead            Boolean  @default(false)
    documentReadAt           DateTime?

    // Versioning
    guardianConsentVersionId String
    contractVersionId        String
    guardianConsentHash      String
    contractHash             String

    // OTP
    otpHash                  String?
    otpSentAt                DateTime?
    otpExpiresAt             DateTime?
    otpVerifiedAt            DateTime?
    attemptCount             Int      @default(0)
    resendCount              Int      @default(0)
    lastResentAt             DateTime?

    // Audit
    ipAddress                String?
    userAgent                String?
    confirmationMethod       String   @default("email_otp")
    sentEmailMessageId       String?
    verifiedAt               DateTime?
    createdAt                DateTime @default(now())
    updatedAt                DateTime @updatedAt

    employee                 Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
    guardianConsentVersion   GuardianConsentVersion @relation(fields: [guardianConsentVersionId], references: [id])
    contractVersion          ContractVersion      @relation(fields: [contractVersionId], references: [id])
    events                   ConsentEvent[]

    @@index([token])
    @@index([representativeEmail])
    @@index([status])
    @@index([createdAt])
}

model MinorPersonalDataConsent {
    id                     String   @id @default(uuid())
    employeeId             String   @unique
    privacyVersionId       String
    privacyHash            String
    confirmedBy            String   @default("GUARDIAN") // GUARDIAN, MINOR
    acceptedAt             DateTime?
    ipAddress              String?
    userAgent              String?
    createdAt              DateTime @default(now())

    employee               Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
    privacyVersion         MinorPrivacyConsentVersion @relation(fields: [privacyVersionId], references: [id])

    @@index([employeeId])
    @@index([acceptedAt])
}

model MinorContractAcceptance {
    id                String   @id @default(uuid())
    employeeId        String   @unique
    contractVersionId String
    contractHash      String
    acceptedAt        DateTime?
    ipAddress         String?
    userAgent         String?
    createdAt         DateTime @default(now())

    employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
    contractVersion ContractVersion @relation(fields: [contractVersionId], references: [id])

    @@index([employeeId])
    @@index([acceptedAt])
}

model EmployeeDocument {
    id           String   @id @default(uuid())
    employeeId   String
    type         String   // EMANCIPATION, AUTHORITY
    fileUrl      String
    originalName String?
    fileSize     Int?
    uploadedAt   DateTime @default(now())

    employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

    @@index([employeeId])
    @@index([type])
}

model ConsentEvent {
    id                         String   @id @default(uuid())
    legalRepresentativeConsentId String?
    employeeId                 String?
    event                      String   // OTP_SENT, OTP_RESENT, OTP_FAILED, OTP_VERIFIED, CONSENT_CONFIRMED, PRIVACY_CONSENT, OFFER_ACCEPTED, DOCUMENT_VIEWED, STATUS_CHANGED
    metadata                   Json?
    ipAddress                  String?
    userAgent                  String?
    createdAt                  DateTime @default(now())

    legalRepresentativeConsent LegalRepresentativeConsent? @relation(fields: [legalRepresentativeConsentId], references: [id], onDelete: Cascade)
    employee                   Employee?                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

    @@index([legalRepresentativeConsentId])
    @@index([employeeId])
    @@index([event])
    @@index([createdAt])
}
